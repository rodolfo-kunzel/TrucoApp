<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card Jogador 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJogador1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/card_j1_bg"
            app:strokeColor="@color/card_j1_stroke"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloMain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLiderJ1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emoji_crown"
                    android:textSize="18sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvNomeJogador1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_jogador_1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvLiderJ1"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvPontosJogador1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pontos_iniciais"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_plus_1_color"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvNomeJogador1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botões de Pontuação do Jogador 1 -->
        <Button
            android:id="@+id/btnMinus1J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_minus_1"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_minus_1_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toBottomOf="@id/cardJogador1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPlus1J1"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <Button
            android:id="@+id/btnPlus1J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_1"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_1_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J1"
            app:layout_constraintStart_toEndOf="@id/btnMinus1J1"
            app:layout_constraintEnd_toStartOf="@id/btnPlus3J1" />

        <Button
            android:id="@+id/btnPlus3J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_3"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_3_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J1"
            app:layout_constraintStart_toEndOf="@id/btnPlus1J1"
            app:layout_constraintEnd_toStartOf="@id/btnPlus6J1" />

        <Button
            android:id="@+id/btnPlus6J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_6"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_6_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J1"
            app:layout_constraintStart_toEndOf="@id/btnPlus3J1"
            app:layout_constraintEnd_toStartOf="@id/btnPlus9J1" />

        <Button
            android:id="@+id/btnPlus9J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_9"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_9_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J1"
            app:layout_constraintStart_toEndOf="@id/btnPlus6J1"
            app:layout_constraintEnd_toStartOf="@id/btnPlus12J1" />

        <Button
            android:id="@+id/btnPlus12J1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_12"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_12_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J1"
            app:layout_constraintStart_toEndOf="@id/btnPlus9J1"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card Jogador 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJogador2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/card_j2_bg"
            app:strokeColor="@color/card_j2_stroke"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/btnMinus1J1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLiderJ2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emoji_crown"
                    android:textSize="18sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvNomeJogador2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_jogador_2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvLiderJ2"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvPontosJogador2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pontos_iniciais"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_plus_6_color"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvNomeJogador2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botões de Pontuação do Jogador 2 -->
        <Button
            android:id="@+id/btnMinus1J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_minus_1"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_minus_1_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toBottomOf="@id/cardJogador2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPlus1J2"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <Button
            android:id="@+id/btnPlus1J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_1"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_1_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J2"
            app:layout_constraintStart_toEndOf="@id/btnMinus1J2"
            app:layout_constraintEnd_toStartOf="@id/btnPlus3J2" />

        <Button
            android:id="@+id/btnPlus3J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_3"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_3_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J2"
            app:layout_constraintStart_toEndOf="@id/btnPlus1J2"
            app:layout_constraintEnd_toStartOf="@id/btnPlus6J2" />

        <Button
            android:id="@+id/btnPlus6J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_6"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_6_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J2"
            app:layout_constraintStart_toEndOf="@id/btnPlus3J2"
            app:layout_constraintEnd_toStartOf="@id/btnPlus9J2" />

        <Button
            android:id="@+id/btnPlus9J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_9"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_9_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J2"
            app:layout_constraintStart_toEndOf="@id/btnPlus6J2"
            app:layout_constraintEnd_toStartOf="@id/btnPlus12J2" />

        <Button
            android:id="@+id/btnPlus12J2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_plus_12"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/btn_plus_12_color"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:layout_constraintTop_toTopOf="@id/btnMinus1J2"
            app:layout_constraintStart_toEndOf="@id/btnPlus9J2"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botões de Ação Organizados em Grid 2x2 Compacto -->
        <Button
            android:id="@+id/btnZerarPartida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_zerar_partida"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/btnMinus1J2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnZerarHistorico"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <Button
            android:id="@+id/btnZerarHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_zerar_historico"
            app:layout_constraintTop_toTopOf="@id/btnZerarPartida"
            app:layout_constraintStart_toEndOf="@id/btnZerarPartida"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_historico"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/btnZerarPartida"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnInformarNomes"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <Button
            android:id="@+id/btnInformarNomes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_informar_nomes"
            app:layout_constraintTop_toTopOf="@id/btnHistorico"
            app:layout_constraintStart_toEndOf="@id/btnHistorico"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>