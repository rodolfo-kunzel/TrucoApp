<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainInformarNomes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".InformarNomesActivity">

    <!-- Top App Header Bar (Stitch Stack Shell) -->
    <LinearLayout
        android:id="@+id/headerInformarNomes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltarNomes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_voltar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/tvTituloInformarNomes"
            style="@style/TextAppearance.TrucoApp.TitleLg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/title_informar_nomes"
            android:textColor="@color/on_surface" />
    </LinearLayout>

    <!-- Scrollable Form Content -->
    <ScrollView
        android:id="@+id/scrollInformarNomes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerInformarNomes">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/margin"
            android:paddingBottom="@dimen/space_md">

            <!-- Subtitle / Context Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_12"
                android:backgroundTint="@color/surface_container_low"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/primary_fixed">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.TrucoApp.TitleMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/identificacao_titulo"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/TextAppearance.TrucoApp.BodyMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:text="@string/identificacao_subtitulo"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Presets Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.TrucoApp.LabelMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sugestoes_rapidas"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    style="@style/TextAppearance.TrucoApp.LabelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/truco_classico"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetNosEles"
                        style="@style/Widget.TrucoApp.Button.PresetChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/preset_nos_eles"
                        app:icon="@drawable/ic_fire"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetMesa"
                        style="@style/Widget.TrucoApp.Button.PresetChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/preset_mesa"
                        app:icon="@drawable/ic_table_bar"
                        app:iconTint="@color/tertiary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetDupla"
                        style="@style/Widget.TrucoApp.Button.PresetChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/preset_dupla"
                        app:icon="@drawable/ic_group"
                        app:iconTint="@color/secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetFamilia"
                        style="@style/Widget.TrucoApp.Button.PresetChip"
                        android:layout_width="wrap_content"
                        android:text="@string/preset_familia"
                        app:icon="@drawable/ic_group"
                        app:iconTint="@color/primary" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Live Preview Card Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_12"
                android:backgroundTint="@color/surface_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/primary" />

                <TextView
                    android:id="@+id/tvPreviewNomeJ1"
                    style="@style/TextAppearance.TrucoApp.TitleMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/jogador_1_default"
                    android:textColor="@color/primary" />

                <TextView
                    style="@style/TextAppearance.TrucoApp.LabelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/surface_container_highest"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/badge_vs"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tvPreviewNomeJ2"
                    style="@style/TextAppearance.TrucoApp.TitleMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/jogador_2_default"
                    android:textColor="@color/secondary" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/secondary_container" />
            </LinearLayout>

            <!-- Field 1: Jogador 1 (Time Azul) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tilNomeJogador1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/primary_fixed">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.TrucoApp.LabelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_input_j1"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNomeJogador1"
                            style="@style/TextAppearance.TrucoApp.TitleMd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="name"
                            android:background="@null"
                            android:hint="@string/hint_digite_nome"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLength="20"
                            android:maxLines="1"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/outline_variant"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnClearNomeJ1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_limpar_jogador_1"
                        android:src="@drawable/ic_close"
                        app:tint="@color/outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.TrucoApp.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="@string/helper_input_j1"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <!-- Field 2: Jogador 2 (Time Laranja) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tilNomeJogador2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/secondary_fixed">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_group"
                            app:tint="@color/secondary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.TrucoApp.LabelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_input_j2"
                            android:textColor="@color/secondary"
                            android:textSize="10sp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNomeJogador2"
                            style="@style/TextAppearance.TrucoApp.TitleMd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="name"
                            android:background="@null"
                            android:hint="@string/hint_digite_nome"
                            android:imeOptions="actionDone"
                            android:inputType="textPersonName"
                            android:maxLength="20"
                            android:maxLines="1"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/outline_variant"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnClearNomeJ2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_limpar_jogador_2"
                        android:src="@drawable/ic_close"
                        app:tint="@color/outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.TrucoApp.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="@string/helper_input_j2"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <!-- Action Button Dock -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmar"
                style="@style/Widget.TrucoApp.Button.PrimaryPill"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_confirmar"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestaurarPadrao"
                style="@style/Widget.TrucoApp.Button.SecondaryPill"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="@string/btn_restaurar_padrao"
                app:icon="@drawable/ic_restart" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
