<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainHistorico"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".HistoricoActivity">

    <!-- Título da Tela -->
    <TextView
        android:id="@+id/tvTituloHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_historico"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Banner Status do Líder Geral -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatusHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFDE7"
        app:strokeColor="#FBC02D"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloHistorico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatusHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/format_empate_historico"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Jogador 1 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHistoricoJ1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/card_j1_bg"
        app:strokeColor="@color/card_j1_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatusHistorico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvIconeJ1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emoji_trophy"
                android:textSize="28sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvHistoricoJogador1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/label_jogador_1"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvIconeJ1"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Jogador 2 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHistoricoJ2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/card_j2_bg"
        app:strokeColor="@color/card_j2_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardHistoricoJ1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvIconeJ2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emoji_trophy"
                android:textSize="28sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvHistoricoJogador2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/label_jogador_2"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvIconeJ2"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltarHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_voltar"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>