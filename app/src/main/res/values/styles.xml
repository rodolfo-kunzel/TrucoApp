<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==========================================================
         Stitch Tento Tracker Component & Widget Styles
         ========================================================== -->

    <!-- Team Scoreboard Cards -->
    <style name="Widget.TrucoApp.ScoreCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">@dimen/card_stroke_normal</item>
    </style>

    <style name="Widget.TrucoApp.ScoreCard.Team1" parent="Widget.TrucoApp.ScoreCard">
        <item name="cardBackgroundColor">@color/card_j1_bg</item>
        <item name="strokeColor">@color/card_j1_stroke</item>
    </style>

    <style name="Widget.TrucoApp.ScoreCard.Team2" parent="Widget.TrucoApp.ScoreCard">
        <item name="cardBackgroundColor">@color/card_j2_bg</item>
        <item name="strokeColor">@color/card_j2_stroke</item>
    </style>

    <!-- Escalation Action Pill Buttons (-1, +1, +3, +6, +9, +12) -->
    <style name="Widget.TrucoApp.Button.Escalation" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_escalation_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelMd</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Quick Action Grid Tonal Buttons (Zerar Partida, Zerar Histórico, Hist. Jogadas, Inf. Nomes) -->
    <style name="Widget.TrucoApp.Button.QuickAction" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/btn_quick_action_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelLg</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Primary Pill Button (Confirmar Nomes / Iniciar Nova Partida) -->
    <style name="Widget.TrucoApp.Button.PrimaryPill" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_primary_cta_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelLg</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Primary Rounded-12 CTA Button (Voltar ao Marcador) -->
    <style name="Widget.TrucoApp.Button.PrimaryRounded" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_primary_cta_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.TitleMd</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Secondary Tonal Pill Button (Restaurar Padrão) -->
    <style name="Widget.TrucoApp.Button.SecondaryPill" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/btn_secondary_cta_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface_container</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelMd</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/on_surface</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Preset Suggestion Pill Button -->
    <style name="Widget.TrucoApp.Button.PresetChip" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">34dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="backgroundTint">@color/surface_container_high</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelMd</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">15dp</item>
    </style>

    <!-- Leader Badge Pill -->
    <style name="Widget.TrucoApp.Badge.Leader" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/tertiary</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/on_tertiary</item>
        <item name="android:textAppearance">@style/TextAppearance.TrucoApp.LabelBadge</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
